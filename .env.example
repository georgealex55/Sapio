# Neon Postgres persistence for feed snapshots and timeline renewals
DATABASE_URL=

# Optional Upstash/Vercel KV-compatible REST persistence
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional API adapters
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:sapio-cultural-intelligence:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# Optional PubMed identification and higher rate limit
NCBI_API_KEY=
NCBI_TOOL=sapio
NCBI_EMAIL=

# Vercel injects CRON_SECRET automatically when configured
CRON_SECRET=
