# Neon Postgres persistence for feed snapshots and timeline renewals
DATABASE_URL=

# Optional Upstash/Vercel KV-compatible REST persistence
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional API adapters
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:sapio-cultural-intelligence:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# Optional PubMed identification and higher rate limit
NCBI_API_KEY=
NCBI_TOOL=sapio
NCBI_EMAIL=

# Vercel injects CRON_SECRET automatically when configured
CRON_SECRET=

# 32+ character HMAC key for private, signed browser history sessions
HISTORY_SIGNING_SECRET=

# Explicit comma-separated HTTPS origins allowed to WRITE browser history.
# Include every real SAPIO HTTPS domain used by visitors; NO trailing slash.
# Keep this unset on unknown hosts; writes fail closed until configured.
SAPIO_ALLOWED_ORIGINS=https://app.xanderit.com,https://app2.xanderit.com,https://sapio-gamma.vercel.app

# VERCEL=1 is injected by Vercel when system environment variables are exposed.
# Do not set it manually when running behind an untrusted reverse proxy.
